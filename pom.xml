<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>pitstudy</groupId>
    <artifactId>pit-mutation-study</artifactId>
    <version>1.0.0</version>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <suite.class>BasicTest</suite.class>
    </properties>

    <dependencies>
        <!-- JUnit 4 keeps this demonstration small and avoids additional PIT adapters. -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <!-- IMPORTANT: run only one test suite per experiment. -->
                    <includes>
                        <include>**/${suite.class}.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.16</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                        <configuration>
                            <formats><format>XML</format></formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.30.2</version>
                <configuration>
                    <targetClasses>
                        <param>pitstudy.OrderRules</param>
                    </targetClasses>
                    <!-- IMPORTANT: PIT also must use only the chosen suite. -->
                    <targetTests>
                        <param>pitstudy.${suite.class}</param>
                    </targetTests>
                    <timestampedReports>false</timestampedReports>
                    <outputFormats>
                        <param>XML</param>
                    </outputFormats>
                    <threads>1</threads>
                    <failWhenNoMutations>true</failWhenNoMutations>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>basic</id>
            <properties><suite.class>BasicTest</suite.class></properties>
        </profile>
        <profile>
            <id>coverage</id>
            <properties><suite.class>CoverageTest</suite.class></properties>
        </profile>
        <profile>
            <id>mutation</id>
            <properties><suite.class>MutationTest</suite.class></properties>
        </profile>
    </profiles>
</project>
